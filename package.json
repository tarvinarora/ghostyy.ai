{
  "name": "ghost-assistant",
  "productName": "Ghost Assistant",
  "version": "1.0.0",
  "description": "A little desktop ghost that keeps your task lists and nudges you three times a day.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"Ghost Assistant\" --platform=darwin --arch=arm64 --out=dist --overwrite"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "@electron/packager": "^18.3.0"
  }
}
